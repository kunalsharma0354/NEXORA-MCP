<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NEXORA_MCP</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sysprompot.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="sysprompt-humanize.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Skills registry: file-based source of truth (skills/<id>/manifest.json
       + SKILL.md), copied next to the exe so the dashboard and the MCP server
       read the same tree. Add a skill = drop in a folder + rebuild. -->
  <ItemGroup>
    <None Include="skills\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="skills\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <!-- Next.js static build (web/ → npm run build → web/out) served to the
       dashboard WebView2 via SetVirtualHostNameToFolderMapping → webui\ -->
  <ItemGroup>
    <None Include="web\out\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="webui\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

</Project>
